# Build output
dist/
# generated per-platform npm packages (built by the npm workflow)
/npm/
*.o
*.a
*.dylib
*.so
*.dll
*.wasm

# Generated at build time
sqlite-predict.h
vendor/sqlite3.c
vendor/sqlite3.h
vendor/sqlite3ext.h
vendor/sqlite-amalgamation*

# libFuzzer failure artifacts (the curated fuzz/seeds/ stays tracked)
crash-*
leak-*
timeout-*
oom-*
fuzz/corpus/

# Python tooling (tests + benchmarks)
__pycache__/
.venv/
.pytest_cache/
.python-version

# OS / editor
.DS_Store
*.swp
*.swo

# local-only working files (internal strategy, private notes); never published
/.local/

# secrets — never commit tokens/keys
.env
.env.local
.env.*.local

# python package (generated amalgamation + build artifacts)
bindings/python/src/
bindings/python/build/
bindings/python/dist/
bindings/python/*.egg-info/
bindings/python/sqlite_predict/predict0.*

# node binding (dev binary + deps)
bindings/node/predict0.*
bindings/node/node_modules/

# rust binding (staged C + build)
bindings/rust/csrc/
bindings/rust/target/
bindings/rust/Cargo.lock

# autogluon working dirs (Mitra benchmark runs dump model copies here)
benchmarks/AutogluonModels/
